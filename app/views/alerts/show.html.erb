<h1>Stockout Alert</h1>

<p>
  <strong>Brand:</strong>
  <%= link_to @alert.brand.name, brand_path(@alert.brand) %>
</p>

<p>
  <strong>Product:</strong>
  <%= link_to @alert.product.name, product_path(@alert.product) %>
</p>

<p>
  <strong>Store:</strong>
  <%= link_to @alert.store.address, store_path(@alert.store) %>
</p>

<p>
  <strong>Triggered:</strong>
  <%= @alert.triggered_at.strftime("%Y-%m-%d %H:%M") %>
</p>

<h2>Consecutive no-inventory events</h2>
<table>
  <thead>
    <tr>
      <th></th>
      <th>Event Time</th>
      <th>Inventory Present?</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>First</td>
      <td><%= @alert.opening_tracking_event.event_time&.strftime("%Y-%m-%d %H:%M") %></td>
      <td>No</td>
    </tr>
    <tr>
      <td>Second</td>
      <td><%= @alert.confirming_tracking_event.event_time&.strftime("%Y-%m-%d %H:%M") %></td>
      <td>No</td>
    </tr>
  </tbody>
</table>

<p><%= link_to "Back to Alerts", alerts_path %></p>
