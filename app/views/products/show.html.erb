<h1><%= @product.name %></h1>

<p>
  <strong>Brand:</strong>
  <% if @product.brand %>
    <%= link_to @product.brand.name, brand_path(@product.brand) %>
  <% else %>
    None
  <% end %>
</p>

<p>
  <strong>Total Tracking Events:</strong>
  <%= @tracking_event_count %>
</p>

<p>
  <strong>Total Price Checks:</strong>
  <%= @price_check_count %>
</p>

<h2>Tracking Events</h2>
<% if @tracking_events.empty? %>
  <p>No tracking events yet.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Event Time</th>
        <th>Inventory Present?</th>
        <th>Store Address</th>
      </tr>
    </thead>
    <tbody>
      <% @tracking_events.each do |event| %>
        <tr>
          <td><%= event.event_time&.strftime("%Y-%m-%d %H:%M") %></td>
          <td><%= event.inventory_present ? "Yes" : "No" %></td>
          <td><%= event.store&.address %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @tracking_event_count > @tracking_events.size %>
    <p><%= link_to "View all tracking events", tracking_events_path(product_id: @product.id) %></p>
  <% end %>
<% end %>

<h2>Price Checks</h2>
<% if @price_checks.empty? %>
  <p>No price checks yet.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Event Time</th>
        <th>Price</th>
        <th>Store Address</th>
      </tr>
    </thead>
    <tbody>
      <% @price_checks.each do |price_check| %>
        <tr>
          <td><%= price_check.event_time&.strftime("%Y-%m-%d %H:%M") %></td>
          <td><%= number_to_currency(price_check.price) %></td>
          <td><%= link_to price_check.store.address, store_path(price_check.store) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @price_check_count > @price_checks.size %>
    <p><%= link_to "View all price checks", price_checks_path(product_id: @product.id) %></p>
  <% end %>
<% end %>

<nav>
  <%= link_to "Back to Products", products_path %> |
  <%= link_to "Brands", brands_path %> |
  <%= link_to "Stores", stores_path %> |
  <%= link_to "Alerts", alerts_path %>
</nav>
