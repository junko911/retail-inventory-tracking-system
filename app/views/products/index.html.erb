<h1>Products</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Brand</th>
      <th>Tracking Events</th>
      <th>Price Checks</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>
        <td><%= product.brand&.name %></td>
        <td><%= @tracking_event_counts[product.id] || 0 %></td>
        <td><%= @price_check_counts[product.id] || 0 %></td>
        <td><%= link_to "View", product_path(product) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<nav>
  <%= link_to "Brands", brands_path %> |
  <%= link_to "Stores", stores_path %> |
  <%= link_to "Alerts", alerts_path %>
</nav>
