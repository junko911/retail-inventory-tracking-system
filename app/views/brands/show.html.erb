<h1><%= @brand.name %></h1>

<p>
  <strong>Total Products:</strong>
  <%= @products.size %>
</p>

<h2>Products</h2>
<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Tracking Events</th>
      <th>Price Checks</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>
        <td><%= @tracking_event_counts[product.id] || 0 %></td>
        <td><%= @price_check_counts[product.id] || 0 %></td>
        <td><%= link_to "View Product", product_path(product) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2>Alerts</h2>
<p><%= pluralize(@alert_count, "alert") %></p>
<% if @alerts.empty? %>
  <p>No alerts yet.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Triggered</th>
        <th>Product</th>
        <th>Store</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @alerts.each do |alert| %>
        <tr>
          <td><%= alert.triggered_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td><%= link_to alert.product.name, product_path(alert.product) %></td>
          <td><%= link_to alert.store.address, store_path(alert.store) %></td>
          <td><%= link_to "View", alert_path(alert) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @alert_count > @alerts.size %>
    <p><%= link_to "View all alerts", alerts_path(brand_id: @brand.id) %></p>
  <% end %>
<% end %>

<nav>
  <%= link_to "Back to Brands", brands_path %> |
  <%= link_to "Products", products_path %> |
  <%= link_to "Stores", stores_path %> |
  <%= link_to "Alerts", alerts_path %>
</nav>
