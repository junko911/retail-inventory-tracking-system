<h1>Brands</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Products</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @brands.each do |brand| %>
      <tr>
        <td><%= brand.name %></td>
        <td><%= @product_counts[brand.id] || 0 %></td>
        <td><%= link_to "View", brand_path(brand) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
